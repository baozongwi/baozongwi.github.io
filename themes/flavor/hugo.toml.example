baseURL = "https://example.com/"
languageCode = "zh-cn"
title = "My Blog"
theme = "flavor"
copyright = "your-name"
hasCJKLanguage = true

[pagination]
  pagerSize = 10

[permalinks]
  post = "/p/:slug/"
  page = "/:slug/"

[outputs]
  home = ["HTML", "RSS"]
  page = ["HTML"]
  section = ["HTML", "RSS"]
  taxonomy = ["HTML"]
  term = ["HTML"]

[params]
  description = "A technical blog."
  mainSections = ["post"]
  avatar = "img/avatar.jpg"
  favicon = "favicon.ico"
  defaultSocialImage = "img/avatar.jpg"
  ogLocale = "zh_CN"
  license = "Licensed under CC BY-NC-SA 4.0"

  [params.author]
    name = "your-name"
    email = "you@example.com"
    url = "/about/"

  [params.welcome]
    enabled = true
    text = "你好"

  [params.footer]
    since = 2024

  [params.typewriter]
    slogans = [
      "stay hungry, stay foolish",
    ]

  # 可选。主题不附带字体；把切好的 unicode-range css/woff2 放到 static/fonts/ 再填路径。
  # [params.font]
  #   css = "fonts/your-font/result.css"
  #   preload = "fonts/your-font/xxxx.woff2"

[menu]
  [[menu.main]]
    name = "Home"
    url = "/"
    weight = 1
    [menu.main.params]
      icon = "home"
  [[menu.main]]
    name = "About"
    url = "/about/"
    weight = 2
    [menu.main.params]
      icon = "user"
  [[menu.main]]
    name = "Archives"
    url = "/archives/"
    weight = 3
    [menu.main.params]
      icon = "archives"
  [[menu.main]]
    name = "Links"
    url = "/links/"
    weight = 4
    [menu.main.params]
      icon = "link"
  [[menu.main]]
    name = "Travel"
    url = "/travel/"
    weight = 5
    [menu.main.params]
      icon = "travel"

  [[menu.social]]
    name = "GitHub"
    url = "https://github.com/you"
    [menu.social.params]
      icon = "github"
  [[menu.social]]
    name = "RSS"
    url = "/index.xml"
    [menu.social.params]
      icon = "rss"

[markup]
  [markup.goldmark]
    [markup.goldmark.renderer]
      unsafe = true
  [markup.tableOfContents]
    startLevel = 2
    endLevel = 4
    ordered = true
  [markup.highlight]
    noClasses = false
    codeFences = true
    lineNos = false
    tabWidth = 4

[imaging]
  quality = 80
  resampleFilter = "CatmullRom"
  hint = "picture"
