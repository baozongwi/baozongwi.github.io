[Unit]
Description=flavor blog stats counter
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/flavor-stats
ExecStart=/opt/flavor-stats/flavor-stats -listen 127.0.0.1:8787 -data /opt/flavor-stats/stats.json -init-pv 207841 -init-uv 46153
Restart=always
RestartSec=2
EnvironmentFile=-/opt/flavor-stats/env
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
