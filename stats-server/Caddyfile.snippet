# 博客在 GitHub Pages（baozongwi.xyz）。
# 计数和留言是两个主机名，后面仍是同一个 flavor-stats。

stats.baozongwi.xyz {
	@api path /hit /stats /health /admin/set
	handle @api {
		reverse_proxy 127.0.0.1:8787
	}
	respond "not found" 404
}

guestbook.baozongwi.xyz {
	@api path /guestbook /guestbook/*
	handle @api {
		reverse_proxy 127.0.0.1:8787
	}
	respond "not found" 404
}
